/*
	# Regular Colors
	
	Background: #14161C
	Border: #09090c
	
	# Token Colors
	
	String: #a4d480
	Character: #bcd9a6 (not strings!! apparently)
	
	Functions/methods: #ee707d
	
	Keyword: #da95e1
	Self: #fab7db
	
	Parameter: #98abd0
	Property: #97aaff
	Constant: #7789f4
*/
{
	"semanticHighlighting": true,
	"colors": {
		"focusBorder": "#2e2f3b",
		// TITLE BAR
		"titleBar.activeForeground": "#dedede",
		"titleBar.activeBackground": "#13151b",
		"titleBar.inactiveBackground": "#0c0e12",
		"titleBar.border": "#09090c",
		// EDITOR
		"editor.background": "#14161C",
		"editor.foreground": "#c7c7c7",
		"editor.foldBackground": "#7a61880c",
		"editorLineNumber.foreground": "#666871",
		"editorLineNumber.activeForeground": "#d6e6ff",
		"editorWarning.foreground": "#ffe23d",
		"editorWarning.background": "#ffc42f43",
		"editorError.foreground": "#e98d84",
		"editorError.background": "#f239be2b",
		"editorWhitespace.foreground": "#7f7fae4c",
		"editorMultiCursor.primary.foreground": "#f6ff00",
		"editorMultiCursor.secondary.foreground": "#ff5bf1",
		"editorCursor.foreground": "#ffffff",
		// TABS
		"editorGroupHeader.noTabsBackground": "#12131a",
		"editorGroupHeader.tabsBackground": "#0d0f13",
		"editorGroupHeader.tabsBorder": "#09090c",
		"tab.activeForeground": "#e1e1e1",
		"tab.activeBackground": "#14161C",
		"tab.activeBorder": "#14161C",
		"tab.activeBorderTop": "#9e85f9",
		"tab.inactiveBackground": "#101217",
		"tab.hoverBackground": "#17191f",
		"tab.border": "#09090c",
		// SIDE BAR
		"sideBar.background": "#16181F",
		"sideBar.border": "#0f1015",
		"sideBarSectionHeader.background": "#20222b",
		"sideBarSectionHeader.border": "#16181F",
		// ACTIVITY BAR
		"activityBar.background": "#21232d",
		"activityBar.border": "#0f1015",
		// LIST
		"list.focusOutline": "#00000000",
		"list.hoverBackground": "#2e2945",
		"list.activeSelectionBackground": "#4f4a7a",
		"list.inactiveSelectionBackground": "#272640",
		"list.highlightForeground": "#feb97d",
		"list.errorForeground": "#ef705c",
		"list.warningForeground": "#ea9e71",
		"tree.inactiveIndentGuidesStroke": "#40374d",
		"tree.indentGuidesStroke": "#876e98",
		// STATUS BAR
		"statusBar.background": "#3b3458",
		"statusBar.debuggingBackground": "#eb7730",
		// "statusBar.border":"#ff0000",
		// INPUT
		"quickInput.background": "#16181F",
		"input.background": "#16181F",
		"input.border": "#5e6789",
		// BUTTON
		"button.background": "#4f66db",
		"button.hoverBackground": "#2d4478",
		// DROPDOWN
		"dropdown.background": "#1b1b21",
		"dropdown.border": "#5e6789",
		// WIDGET
		"editorWidget.background": "#14161C",
		"editorWidget.border": "#454545",
		"editorSuggestWidget.border": "#242730",
		"editorSuggestWidget.background": "#16181F",
		"editorSuggestWidget.selectedBackground": "#1a1c24",
		"editorHoverWidget.background": "#16181F",
		"editorHoverWidget.border": "#242730",
		"textLink.foreground": "#5787ff",
		"textBlockQuote.background": "#212633",
		"diffEditorGutter.insertedLineBackground": "#36622b",
		"diffEditorGutter.removedLineBackground": "#642727",
		"diffEditor.unchangedCodeBackground": "#ff88001d",
		"diffEditor.unchangedRegionShadow": "#ffa500",
		"diffEditor.border": "#374468",
		// SCROLLBAR
		"scrollbarSlider.background": "#c8c8c871",
		"scrollbarSlider.hoverBackground": "#99999971",
		"scrollbarSlider.activeBackground": "#393939ba",
		// MENU
		"menu.background": "#191B21",
		"menu.border": "#13151A",
		"menu.selectionBackground": "#24272e",
		// GIT
		"gitDecoration.modifiedResourceForeground": "#fad895",
		"gitDecoration.untrackedResourceForeground": "#5dd58d",
		"gitDecoration.deletedResourceForeground": "#f83184",
		// PANEL
		"panel.background": "#111318",
		"panel.border": "#0f1015",
		// NOTIFICATIONS
		"notificationsErrorIcon.foreground": "#e2685d",
		"notificationsInfoIcon.foreground": "#5ca8ff",
		"notifications.background": "#14161C",
		"notifications.border": "#101216",
		"notifications.foreground": "#cdcdcd",
		"notificationCenter.border": "#101216",
	},
	"semanticTokenColors": {
		"property": "#97aaff",
		"property.defaultLibrary": "#f08dbb",
		"property.defaultLibrary.readonly": "#7789f4",
		"parameter": "#e1ae7e",
		"function": "#ee707d",
		"function.defaultLibrary": "#ec5e92",
		"enum": "#f56767",
		"enumMember": "#cb4444",
		"event": "#ffd572",
		"module": "#a1efc4",
		"string": "#a4d480",
		"character": "#bcd9a6",
		// self
		"selfKeyword": "#fab7db",
		"selfParameter": "#f38888",
		"selfTypeKeyword": "#fab7db",
		// Rust (mostly)
		"namespace:rust": "#9e8eed",
		"struct:rust": "#73d5b6",
		"macro:rust": "#fea56e", // macros aren't functions!
		"*.attribute:rust": "#fec864",
		"attributeBracket:rust": "#ff9e3c",
		"builtinAttribute:rust": "#ffa220",
		"keyword.crateRoot:rust": "#eca4a4",
		"variable.callable:rust": "#ee707d", // essentially just for closures (dynamic functions)
		// "variable.mutable:rust": {
		// 	"italic": true
		// },
		// "variable.reference:rust": {
		// 	"underline": true
		// },
		// Python
		"class:python": "#bca1f7",
	},
	"tokenColors": [
		// FUNDAMENTALS
		{
			"scope": "comment",
			"settings": {
				"foreground": "#5a9b54",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#a4d480"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#e55c5c",
				"fontStyle": "underline"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#D2A6FF",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#ff7ab2",
				"fontStyle": ""
			}
		},
		{
			"scope": "support.class",
			"settings": {
				"foreground": "#ff7373"
			}
		},
		// VARIABLES
		{
			"scope": "variable",
			"settings": {
				"foreground": "#c4d3f9"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#e1ae7e"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"variable.property.luau"
			],
			"settings": {
				"foreground": "#97aaff"
			}
		},
		// KEYWORDS
		{
			"scope": [
				"storage.modifier",
				"keyword.local.lua"
			],
			"settings": {
				"foreground": "#88a1f4"
			}
		},
		{
			"scope": "keyword.control",
			"settings": {
				"foreground": "#da95e1"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#da7f7f"
			}
		},
		{
			"scope": "keyword.operator.wordlike",
			"settings": {
				"foreground": "#729cea",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "keyword.operator.arithmetic",
			"settings": {
				"foreground": "#ffbe26",
			}
		},
		{
			"scope": "keyword.operator.assignment",
			"settings": {
				"foreground": "#7a6ebd"
			}
		},
		{
			"scope": "keyword.operator.type",
			"settings": {
				"foreground": "#ef8986"
			}
		},
		// LANGUAGE
		{
			"scope": "constant.language.boolean",
			"settings": {
				"foreground": "#ffab6e",
				"fontStyle": ""
			}
		},
		{
			"scope": "constant.language.nil",
			"settings": {
				"foreground": "#727272"
			}
		},
		{
			"scope": [
				"variable.other.constant",
				"support.constant"
			],
			"settings": {
				"foreground": "#7789f4",
			}
		},
		{
			"scope": "support.type.property-name",
			"settings": {
				"foreground": "#a6bcf0"
			}
		},
		// FUNCTIONS
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic.python"
			],
			"settings": {
				"foreground": "#ee707d"
			}
		},
		// TYPES
		{
			"scope": [
				"support.type",
				"entity.name.type"
			],
			"settings": {
				"foreground": "#fedd7a"
			}
		},
		{
			"scope": "storage.type",
			"settings": {
				"foreground": "#f6778c"
			}
		},
		// Rust
		{
			"scope": "punctuation.brackets.angle.rust",
			"settings": {
				"foreground": "#da7f7f"
			}
		},
		// Python
		{
			"scope": [
				"punctuation.section"
			],
			"settings": {
				"foreground": "#c4b78a"
			}
		},
		{
			"scope": "punctuation.separator.colon.python",
			"settings": {
				"foreground": "#f58282"
			}
		},
		{
			"scope": "punctuation.separator.period.python",
			"settings": {
				"foreground": "#bfd0d6"
			}
		},
		// HLSL
		{
			"scope": "keyword.preprocessor",
			"settings": {
				"foreground": "#e36bb1"
			}
		},
		{
			"scope": "support.variable.semantic",
			"settings": {
				"foreground": "#f9b351"
			}
		},
		// Markdown
		{
			"scope": [
				"punctuation.definition.heading",
				"punctuation.definition.list"
			],
			"settings": {
				"foreground": "#c585d8"
			}
		},
		{
			"scope": "markup.strikethrough",
			"settings": {
				"foreground": "#a0a0a0"
				// "fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"foreground": "#91c5f5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "heading",
			"settings": {
				"foreground": "#ff9090"
			}
		},
		{
			"scope": "markup.list",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "meta.paragraph.markdown",
			"settings": {
				"foreground": "#bbe3fc"
			}
		}
	],
}