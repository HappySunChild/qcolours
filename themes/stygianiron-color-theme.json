	"semanticTokenColors": {
		"property": "#97aaff",
		"property.defaultLibrary":"#f08dbb",
		"property.defaultLibrary.readonly": "#7789f4",
		
		"parameter": "#e79e73",
		"selfParameter": "#f38888",
		
		"enumMember": "#cb4444",
		"enum": "#f56767",
		
		"event": "#ffd572",
		
		"module": "#a1efc4",
		
		"class:python": "#bca1f7",
	},
	"tokenColors": [
		// Fundamentals
		{
			"scope": "comment",
			"settings": {
				"foreground": "#5a9b54",
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#a4d480"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#e55c5c",
				"fontStyle": "underline"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#D2A6FF",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#ff7ab2",
				"fontStyle": ""
			}
		},
		{
			"scope": "support.class",
			"settings": {
				"foreground": "#ff7373"
			}
		},
		
		// VARIABLES
		{
			"scope": "variable",
			"settings": {
				"foreground": "#c4d3f9"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#e79e73"
			}
		},
		{
			"scope": ["variable.other.property", "variable.property.luau"],
			"settings": {
				"foreground": "#97aaff"
			}
		},
		
		
		// KEYWORDS
		{
			"scope": ["storage.modifier", "keyword.local.lua"],
			"settings": {
				"foreground": "#88a1f4"
			}
		},
		{
			"scope": "keyword.control",
			"settings": {
				"foreground": "#da95e1"
			}
		},
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#f27979"
			}
		},
		{
			"scope": "keyword.operator.arithmetic",
			"settings": {
				"foreground": "#ffbe26",
			}
		},
		{
			"scope": "keyword.operator.assignment",
			"settings": {
				"foreground": "#7a6ebd"
			}
		},
		{
			"scope": "keyword.operator.type",
			"settings": {
				"foreground": "#ef8986"
			}
		},
		
		
		// LANGUAGE
		{
			"scope": "constant.language.boolean",
			"settings": {
				"foreground": "#ffab6e",
				"fontStyle": ""
			}
		},
		{
			"scope": "constant.language.nil",
			"settings": {
				"foreground": "#727272"
			}
		},
		{
			"scope": ["variable.other.constant", "support.constant"],
			"settings": {
				"foreground": "#7789f4",
			}
		},
		{
			"scope": "support.type.property-name",
			"settings": {
				"foreground": "#a6bcf0"
			}
		},
		
		// FUNCTIONS
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic.python"],
			"settings": {
				"foreground": "#f36c7a"
			}
		},
		
		// TYPES
		{
			"scope": ["support.type", "entity.name.type"],
			"settings": {
				"foreground": "#fedd7a"
			}
		},
		{
			"scope": "storage.type",
			"settings": {
				"foreground": "#f6778c"
			}
		},
		
		
		
		
		
		// Python
		{
			"scope": ["punctuation.section"],
			"settings": {
				"foreground": "#c4b78a"
			}
		},
		{
			"scope": "punctuation.separator.colon.python",
			"settings": {
				"foreground": "#f58282"
			}
		},
		{
			"scope": "punctuation.separator.period.python",
			"settings": {
				"foreground": "#bfd0d6"
			}
		},
		
		
		
		
		
		
		// HLSL
		{
			"scope": "keyword.preprocessor",
			"settings": {
				"foreground": "#e36bb1"
			}
		},
		{
			"scope": "support.variable.semantic",
			"settings": {
				"foreground": "#f9b351"
			}
		},
		
		
		
		
		
		
		// Markdown
		{
			"scope": ["punctuation.definition.heading", "punctuation.definition.list"],
			"settings": {
				"foreground": "#c585d8"
			}
		},
		
		{
			"scope": "markup.strikethrough",
			"settings": {
				"foreground": "#a0a0a0"
				// "fontStyle": "strikethrough"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"foreground": "#91c5f5",
				"fontStyle": "italic"
			}
		},
		
		{
			"scope": "heading",
			"settings": {
				"foreground": "#ff9090"
			}
		},
		{
			"scope": "markup.list",
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": "meta.paragraph.markdown",
			"settings": {
				"foreground": "#bbe3fc"
			}
		}
	],
}