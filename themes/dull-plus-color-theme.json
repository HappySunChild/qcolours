		{
			"scope": "constant.language.nil",
			"settings": {
				"foreground": "#575757",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#f76464"
			}
		},
		
		
		
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#cccccc"
			}
