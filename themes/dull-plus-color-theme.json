{
	"tokenColors": [
		{
			"scope": "storage.modifier",
			"settings": {
				"foreground": "#9b8eff"
			}
		},
		{
			"scope": "storage.type.class",
			"settings": {
				"foreground": "#a08bef"
			}
			
		},
		{
			"scope": "storage.type.lua",
			"settings": {
				"foreground": "#ef9d9d"
			}
		},
		{
			"scope": "entity.name.type.alias.lua",
			"settings": {
				"foreground": "#f6b5fb"
			}
		},
		{
			"scope": "support.type",
			"settings": {
				"foreground": "#f07676",
				"fontStyle": "italic"
			}
		},
		
		
		
		{
			"scope": "comment",
			"settings": {
				"foreground": "#498492",
				"fontStyle": "italic"
			}
		},
		
		
		{
			"scope": "string",
			"settings": {
				"foreground": "#58d35e"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#00fff2",
				"fontStyle": "italic underline"
			}
		},
		{
			"scope": "meta.embedded.line",
			"settings": {
				"fontStyle": "italic"
			}
		},
		
		
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#fb46ce"
			}
