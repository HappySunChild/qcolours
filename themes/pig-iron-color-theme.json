	"semanticTokenColors": {
		// COMMON
		"comment": {
			"italic": true,
			"foreground": "#6ba85c"
		},
		"number": "#ff94f1",
		"operator": "#da7f7f",
		"boolean": {
			"foreground": "#ffbf6a",
			"italic": true
		},
		"keyword": "#e7b498",
		"keyword.constant": "#e18e6f",
		"keyword.controlFlow": "#fb8383",
		// STRING
		"string": "#a4d480",
		"formatSpecifier": "#96a35c",
		"escapeSequence": "#e76d6d",
		// SELF
		"selfKeyword": "#fab7db",
		"selfParameter": "#f38888",
		"selfTypeKeyword": "#fab7db",
		// VARIABLE
		"const": {
			"foreground": "#7789f4",
			"italic": true
		},
		"variable": "#c9ceff",
		"parameter": "#9da0ff",
		// CALLABLE
		"function": "#ee7c87",
		"method": "#ee7c87",
		"macro": "#eec489", // macros aren't functions!
		// ENUM
		"enum": "#f56767",
		"enumMember": "#af4343",
		// STRUCT
		"struct": "#75eec8",
		"property": "#9fb0ff",
		//
		"interface": "#f1e16a",
		"builtinType": "#f1e16a",
		"namespace": "#f688d8",
		// RUST
		"lifetime:rust": "#7e8cf5",
		"*.attribute": "#edb871",
		"attributeBracket": "#e89221"
	},
	"tokenColors": [
		// COMMON
		{
			"scope": "comment",
			"settings": {
				"foreground": "#6ba85c",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "string",
			"settings": {
				"foreground": "#a4d480"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#e7b498"
			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#c9ceff"
			}
		},
		{
			"scope": "variable.language.self",
			"settings": {
				"foreground": "#fab7db"
			}
		},
		{
			"scope": "entity",
			"settings": {
				"foreground": "#f688d8"
			}
		},
		{
			"scope": "entity.name.type",
			"settings": {
				"foreground": "#f1e16a"
			}
		},
		{
			"scope": "storage.type",
			"settings": {
				"foreground": "#e18e6f"
			}
		},
		{
			"scope": "constant.other",
			"settings": {
				"foreground": "#7789f4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#ff94f1"
			}
		},
		// RUST
		{
			"scope": "keyword.operator.borrow.and.rust",
			"settings": {
				"foreground": "#ff6d6d"
			}
		},
		// TOML
		{
			"scope": "support.type.property-name.table.toml",
			"settings": {
				"foreground": "#f88d8d",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "support.type.property-name.toml",
			"settings": {
				"foreground": "#a8cbff"
			}
		},
		// JSON
		{
			"scope": "support.type.property-name.json",
			"settings": {
				"foreground": "#9eb2ef"
			}
		},
		{
			"scope": "constant.language.json",
			"settings": {
				"foreground": "#ffbf6a",
				"fontStyle": "italic"
			}
		}
	]
}