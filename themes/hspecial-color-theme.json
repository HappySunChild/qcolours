{
	"name": "hspecial",
	"tokenColors": [
		// Language & Functions
		{
			"scope": "string",
			"settings": {
				"foreground": "#89c770"
			}
		},
		{
			"scope": "keyword.control",
			"settings": {
				"foreground": "#a96db8"
			}
		},
		{
			"scope": "support.function",
			"settings": {
				"foreground": "#dd585e"
			}
		},
		{
			"scope": "support.class",
			"settings": {
				"foreground": "#C7444A"
			}
		},
		{
			"scope": "support.constant",
			"settings": {
				"foreground": "#22AA44",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "constant.language",
			"settings": {
				"foreground": "#24c796"
			}
		},
		{
			"scope": "constant.character.escape",
			"settings": {
				"foreground": "#8080FF",
			}
		},
		{
			"scope": "constant.language.boolean",
			"settings": {
				"foreground": "#d68017",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "source.ignore",
			"settings": {
				"foreground": "#009b34d0"
			}
		},
		
		// Python
		{
			"scope": "storage.type.function.python",
			"settings": {
				"foreground": "#ddcc69"
			}
		},
		{
			"scope": "support.type.python",
			"settings": {
				"foreground": "#df7373"
			}
		},
		{
			"scope": "meta.function-call.generic.python",
			"settings": {
				"foreground": "#81b2e0"
			}
		},
		{
			"scope": "meta.function-call.arguments.python",
			"settings": {
				"foreground": "#a785df",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "meta.member.access.python",
			"settings": {
				"foreground": "#8aabe7"
			}
		},
		
		// Lua
		{
			"scope": "support.constant.lua",
			"settings": {
				"foreground": "#7ab8e2",
				"fontStyle": ""
			}
		},
		{
			"scope": "entity.name.function.lua",
			"settings": {
				"foreground": "#888af1"
			}
		},
		{
			"scope": "constant.language.nil",
			"settings": {
				"foreground": "#509e9e",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "keyword.local",
			"settings": {
				"foreground": "#7981ca"
			}
		},
		{
			"scope": "entity.other.attribute.lua",
			"settings": {
				"foreground": "#5c93ce"
			}
		},
		
		// AHK
		{
			"scope": "support.function.ahk",
			"settings": {
				"foreground": "#7981ca"
			}
		},
		{
			"scope": "keyword.keys.ahk",
			"settings": {
				"foreground": "#99b7ee"
			}
		},
		{
			"scope": "punctuation.definition.variable.percent.ahk",
			"settings": {
				"foreground": "#1edaa1"
			}
		},
		{
			"scope": "entity.name.function.label.ahk",
			"settings": {
				"foreground": "#caae7a"
			}
		},
		{
			"scope": "hotkeyline.ahk",
			"settings": {
				"foreground": "#7ca077"
			}
		},
		
		// CSS
		{
			"scope": "meta.selector.css",
			"settings": {
				"foreground": "#37c7eb"
			}
		},
		{
			"scope": "meta.property-name.css",
			"settings": {
				"foreground": "#33abf0",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "support.constant.property-value.css",
			"settings": {
				"foreground": "#aa8347",
				"fontStyle": ""
			}
		},
		
		// XML
		{
			"scope": "entity.name.tag.localname.xml",
			"settings": {
				"foreground": "#8080ffe3"
			}
		},
		{
			"scope": "punctuation.definition.tag.xml",
			"settings": {
				"foreground": "#80f7ffe3"
			}
		},
		{
			"scope": "entity.other.attribute-name.localname.xml",
			"settings": {
				"foreground": "#df8e3e"
			}
		},
		{
			"scope": "text.xml",
			"settings": {
				"foreground": "#de74f8"
			}
		},
		
		// Markdown
		{
			"scope": "punctuation.definition.heading.markdown",
			"settings": {
				"foreground": "#8080ffe3"
			}
		},
		{
			"scope": "punctuation.definition.markdown",
			"settings": {
				"foreground": "#6caef5"
			}
		},
		{
			"scope": "string.other.link.title.markdown",
			"settings": {
				"foreground": "#8080ffe3"
			}
		},
		{
			"scope": "meta.link.inline.markdown",
			"settings": {
				"foreground": "#a1a1fce3",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inline.raw.string.markdown",
			"settings": {
				"foreground": "#89ff99",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "fenced_code.block.language.markdown",
			"settings": {
				"foreground": "#8490fc",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#00a2ff"
			}
		},
		{
			"scope": "entity.name.section.markdown",
			"settings": {
				"foreground": "#6ac1db"
			}
		},
		
		// TOML
		{
			"scope": "support.type.property-name.table.toml",
			"settings": {
				"foreground": "#8080ffe3"
			}
		},
		{
			"scope": "meta.entry.toml",
			"settings": {
				"foreground": "#8080ffe3"
			}
		},
		{
			"scope": "punctuation.eq.toml",
			"settings": {
				"foreground": "#80f7ffe3"
			}
		},
		{
			"scope": "punctuation.definition.table.inline.toml",
			"settings": {
				"foreground": "#df8e3e"
			}
		},
		
		// JSON
		{
			"scope": "support.type.property-name.json",
			"settings": {
				"foreground": "#999beb",
				"fontStyle": "italic"
			}
		},
		
		// Comment
		{
			"scope": "comment",
			"settings": {
				"foreground": "#686868",
				"fontStyle": "italic"
			}
		},
		
		// Numbers
		{
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#eeb259"
			}
		},
		
		//Function
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#df8e3e"
			}
		},
		
		// Operators
		{
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#a0a092"
			}
		},
		{
			"scope": "keyword.operator.arithmetic",
			"settings": {
				"foreground": "#51c051"
			}
		},
		
		// Variables
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#8cb0d6"
			}
		},
		{
			"scope": "variable.other.property",
			"settings": {
				"foreground": "#c678dd"
			}
		},
		{
			"scope": "variable.language.metamethod",
			"settings": {
				"foreground": "#dd484f"
			}
		},
		{
			"scope": "variable.language.self",
			"settings": {
				"foreground": "#c24b51",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#6caef5",
				"fontStyle": "italic"
			}
		},
		
		// Types
		{
			"scope": "entity.name.type.alias",
			"settings": {
				"foreground": "#84b8fc",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "support.type.primitive",
			"settings": {
				"foreground": "#65d3ff",
			}
		},
		{
			"scope": "entity.name.type",
			"settings": {
				"foreground": "#84b8fc",
				"fontStyle": "italic"
			}
		},
	]
}
